# Discovery Engine - Environment Configuration Template
# Copy this file to .env to configure local settings:
#   copy .env.example .env

# --- Discovery Assistant (LLM Concierge) ---
# Enable the conversational chatbot assistant
CHAT_ENABLED=true

# Google Gemini API key(s) - never committed to git
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=your_gemini_api_key_here

# Upstream model identifier (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: Project labels if using multiple distinct GCP projects for quota
# GEMINI_KEY_PROJECTS=my-gcp-project-1

# Optional rate and timeout controls
# GEMINI_RPM_PER_PROJECT=10.0
# CHAT_IP_RPM=6
# CHAT_TIMEOUT_S=8.0
# CHAT_CACHE_TTL_S=600

# --- Server Configuration ---
# ARTIFACT_DIR=artifacts
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# LOG_LEVEL=INFO

